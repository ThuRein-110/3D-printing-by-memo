{
  "name": "3d-printing-mfu",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "node scripts/rls-test.mjs",
    "worker": "tsx scripts/worker.ts",
    "security": "pnpm audit --prod --audit-level high",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@supabase/supabase-js": "^2.95.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "pdf-lib": "1.17.1",
    "tsx": "^4.21.0",
    "turbo": "2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@mfu/database": "workspace:*",
    "@mfu/pricing": "workspace:*",
    "@mfu/three": "workspace:*",
    "@mfu/types": "workspace:*",
    "@mfu/validation": "workspace:*"
  },
  "type": "module"
}
