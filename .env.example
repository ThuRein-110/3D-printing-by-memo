# Copy into users/.env.local and admin/.env.local. No public secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_ORIGIN=http://localhost:3000
# Admin MFA is always required by the database; there is no bypass flag.
# Server-only credential: set in both web projects and the worker; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Worker only: do not add this key to the Vercel web projects.
MESHY_API_KEY=
PREVIEW_PROVIDER=disabled
PROVIDER_ASSET_HOSTS=assets.meshy.ai
PREVIEW_JOB_BUDGET_THB=0
# Global concurrency is enforced in PostgreSQL: 1 active lease.
