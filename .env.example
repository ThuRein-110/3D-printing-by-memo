# Copy into users/.env.local and admin/.env.local. No public secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_ORIGIN=http://localhost:3000
# Admin deployment only: overrides APP_ORIGIN for admin API CSRF checks.
# ADMIN_ORIGIN=http://localhost:3001
# Optional comma-separated exact aliases for THIS deployment. No wildcards.
# ALLOWED_ORIGINS=https://admin.example.com,https://admin-alias.example.com
# Admin MFA is always required by the database; there is no bypass flag.
# Server-only credential: set in both web projects and the worker; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Customer auth: Google must be enabled in Supabase with your Google OAuth client.
# Student email challenge delivery (server only; verified sender required).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Vercel adds this bearer token to the daily security metadata retention job.
CRON_SECRET=
# Keep disabled until MFU has authorized and provisioned the integration.
MFU_SSO_AUTHORIZED=false
MFU_SSO_KIND=
MFU_SSO_PROVIDER_ID=
# Enable only after the trusted Supabase Auth hook mapping has been reviewed.
MFU_SSO_TRUST_ENROLLMENT_CLAIM=false
# Worker only: do not add this key to the Vercel web projects.
MESHY_API_KEY=
PREVIEW_PROVIDER=disabled
PROVIDER_ASSET_HOSTS=assets.meshy.ai
# Daily limits, monthly allowance, reviewed cost/credit and concurrency are
# configured by an MFA-verified admin in Settings after migration 009.
